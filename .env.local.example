# Copie ce fichier en `.env.local` puis remplis la clé anon.
# Project Settings > API dans le dashboard Supabase du projet xxfqvbvyasnnvmycpogx.

NEXT_PUBLIC_SUPABASE_URL=https://xxfqvbvyasnnvmycpogx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role (serveur uniquement, JAMAIS exposée au client) — pour les accès serveur (Studio, Social Ads).
# Optionnel : URL publique du site (liens de validation Social Ads).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=

# --- Module Social Ads (aperçu & validation de campagnes) ---
# Assistant de rédaction marketing. Fournisseur pluggable : OpenRouter est
# prioritaire s'il est défini, sinon Anthropic direct. Sans aucune clé, le bouton
# « Rédiger avec l'IA » renvoie un message ; le reste du module fonctionne.
#
# Option A — OpenRouter (compatible OpenAI, route vers Claude et d'autres) :
OPENROUTER_API_KEY=
# Modèle OpenRouter (ex. anthropic/claude-3.5-sonnet, anthropic/claude-sonnet-4,
# openai/gpt-4o, google/gemini-2.0-flash…). Défaut : anthropic/claude-3.5-sonnet.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
#
# Option B — Anthropic direct (utilisé seulement si OPENROUTER_API_KEY est vide) :
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Requis pour la page publique /preview/{token} (lecture/écriture des commentaires
# et validations côté serveur) : c'est la clé SUPABASE_SERVICE_ROLE_KEY ci-dessus.
# Le bucket de stockage public « social-ads » est créé par la migration.
